# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by cron routes, webhooks and admin
# actions after the caller has been verified.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public origin, no trailing slash. Used in emails and calendar event links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Where admin notifications (new plan requests) are sent.
ADMIN_NOTIFICATION_EMAIL=

# --- Cron ---
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/* (daily-sync,
# renewal-reminders, expiration-warnings, booking-reminders, calendar-sync).
CRON_SECRET=

# --- Google Calendar sync (optional; see docs/GOOGLE_CALENDAR.md) ---
# All three must be set for the integration to be enabled. Leave empty to
# disable — booking, cancel and generate keep working without it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the `private_key` value from the service-account JSON. Vercel keeps
# the literal "\n" sequences; the app converts them to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The Calendar ID of the studio's dedicated secondary calendar, e.g.
# abc123@group.calendar.google.com (Google Calendar → Settings → Integrate).
GOOGLE_CALENDAR_ID=
